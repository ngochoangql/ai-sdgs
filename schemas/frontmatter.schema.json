{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdgs.org/schemas/v1/frontmatter.schema.json",
  "title": "AI-SDGS Governed Document YAML Frontmatter Schema",
  "description": "Validates YAML frontmatter across Universal Standards (STD-*), Constitutional Docs, Requirements (REQ-*), and Architecture Decisions (ADR-*) (STD-003, STD-004, STD-005, STD-008).",
  "type": "object",
  "required": [
    "id",
    "title",
    "version",
    "status",
    "last_updated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(STD-(0[0-9]{2}|[1-9][0-9]{2})|CONST-[0-9]{3}|REQ-(FUNC|NFUNC|SEC|DATA|INT)-[0-9]{3,4}|ADR-[0-9]{3,4}|CONTRACT-[A-Z0-9-]+|DOC-(RES|ARCH|PLT)-[0-9]{3})$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "IN_REVIEW",
        "APPROVED",
        "AMENDING",
        "SUPERSEDED",
        "DEPRECATED"
      ]
    },
    "artifact_class": {
      "type": "string",
      "enum": [
        "CONSTITUTIONAL",
        "NORMATIVE_SPEC",
        "GOVERNANCE_RECORD",
        "INFORMATIVE_OR_DERIVED"
      ]
    },
    "domain": {
      "type": "string"
    },
    "applies_to_tiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["LITE", "STANDARD", "STRICT"]
      }
    },
    "priority": {
      "type": "string",
      "enum": ["MUST", "SHOULD", "MAY", "CRITICAL", "HIGH", "MEDIUM", "LOW"]
    },
    "approved_by": {
      "type": "string",
      "minLength": 2
    },
    "supersedes": {
      "type": "array",
      "items": { "type": "string", "minLength": 3 }
    },
    "superseded_by": {
      "type": "string",
      "minLength": 3
    },
    "normative_references": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "related_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 5 }
    },
    "last_updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "SUPERSEDED" } }
      },
      "then": {
        "required": ["superseded_by"]
      }
    },
    {
      "if": {
        "properties": {
          "id": { "pattern": "^REQ-(FUNC|NFUNC|SEC|DATA|INT)-[0-9]{3,4}$" },
          "status": { "const": "APPROVED" }
        }
      },
      "then": {
        "required": ["artifact_class", "priority", "acceptance_criteria"]
      }
    }
  ]
}
