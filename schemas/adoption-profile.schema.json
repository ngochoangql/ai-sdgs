{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdgs.org/schemas/v1/adoption-profile.schema.json",
  "title": "AI-SDGS Project Adoption Profile (.aisdgs/adoption-profile.yaml)",
  "description": "Validates standard applicability classifications and Not Applicable justifications (STD-002-R01).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_version",
    "adoption_tier",
    "onboarding_mode",
    "approved_by",
    "standards"
  ],
  "properties": {
    "profile_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "adoption_tier": {
      "type": "string",
      "enum": ["LITE", "STANDARD", "STRICT"]
    },
    "onboarding_mode": {
      "type": "string",
      "enum": ["GREENFIELD", "BROWNFIELD", "ITERATIVE"]
    },
    "approved_by": {
      "type": "string",
      "minLength": 2
    },
    "standards": {
      "type": "array",
      "minItems": 12,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "applicability"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^STD-(0[0-9]{2}|[1-9][0-9]{2})$"
          },
          "applicability": {
            "type": "string",
            "enum": [
              "MANDATORY",
              "CONDITIONAL_ACTIVE",
              "OPTIONAL_ENABLED",
              "NOT_APPLICABLE"
            ]
          },
          "justification": {
            "type": "string",
            "minLength": 10
          },
          "tailoring_notes": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "applicability": { "const": "NOT_APPLICABLE" } }
            },
            "then": {
              "required": ["justification"]
            }
          }
        ]
      }
    }
  }
}
