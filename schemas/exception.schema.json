{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdgs.org/schemas/v1/exception.schema.json",
  "title": "AI-SDGS Governance Exceptions & Waivers Schema (governance/EXCEPTIONS.md)",
  "description": "Validates time-bounded governance waivers in governance/EXCEPTIONS.md frontmatter, forbidding CRITICAL unmitigated waivers and requiring compensating controls (STD-002-R04..R06).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "version",
    "status",
    "artifact_class",
    "last_updated",
    "waivers"
  ],
  "properties": {
    "id": {
      "type": "string",
      "const": "EXCEPTIONS-001"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "APPROVED"]
    },
    "artifact_class": {
      "type": "string",
      "const": "CONSTITUTIONAL"
    },
    "last_updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "waives_rules",
          "affected_scope",
          "risk_level",
          "justification",
          "compensating_control",
          "remediation_plan",
          "expires_at",
          "approved_by",
          "approved_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EXC-[0-9]{4}$"
          },
          "status": {
            "type": "string",
            "enum": ["DRAFT", "ACTIVE", "CLOSED", "EXPIRED"]
          },
          "waives_rules": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(STD-[0-9]{3}-R[0-9]{2}|PROJ-R[0-9]{2,3})$"
            }
          },
          "affected_scope": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "risk_level": {
            "type": "string",
            "description": "CRITICAL risk waivers are strictly forbidden by STD-002-R04.",
            "enum": ["LOW", "MEDIUM", "HIGH"]
          },
          "justification": {
            "type": "string",
            "minLength": 10
          },
          "compensating_control": {
            "type": "string",
            "minLength": 10
          },
          "remediation_plan": {
            "type": "string",
            "minLength": 10
          },
          "expires_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "approved_by": {
            "type": "string",
            "minLength": 2,
            "not": {
              "pattern": "^(AI-|ai-|bot|agent|claude|gemini|gpt|copilot)"
            }
          },
          "approved_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    }
  }
}
