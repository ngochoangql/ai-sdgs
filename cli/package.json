{
  "name": "ai-sdgs",
  "version": "1.0.1",
  "description": "AI-SDGS Governance & Deterministic Enforcement CLI (Zero-Dependency Node.js Native TypeScript)",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "ai-sdgs": "bin/aisdgs.mjs",
    "aisdgs": "bin/aisdgs.mjs"
  },
  "scripts": {
    "embed": "node ./scripts/embed-bundle.ts",
    "build:release": "node ./scripts/embed-bundle.ts && node ./scripts/build-release.ts",
    "build:sea": "npm run build:release && node ./scripts/build-sea.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test ./tests/**/*.test.ts",
    "prepack": "npm run build:release && npm run typecheck && npm test",
    "start": "node ./src/main.ts"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "scripts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai-sdgs",
    "governance",
    "ai-agents",
    "mcp",
    "claude",
    "cursor",
    "compliance"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
