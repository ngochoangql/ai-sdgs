{
  "name": "@ai-sdgs/cli",
  "version": "1.0.0",
  "description": "AI-SDGS Governance & Deterministic Enforcement CLI (Zero-Dependency Node.js v24 Native TypeScript)",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "aisdgs": "./bin/aisdgs.mjs"
  },
  "scripts": {
    "embed": "node ./scripts/embed-bundle.ts",
    "build:release": "node ./scripts/embed-bundle.ts && node ./scripts/build-release.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test ./tests/**/*.test.ts",
    "start": "node ./src/main.ts"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
